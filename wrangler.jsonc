{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amplifi-quotes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [],
  "upload_source_maps": true,
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/widget/*", "/robots.txt"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO", "DirectoryDO"] }],
  "vars": {
    "EDITION": "self",
    "APP_VERSION": "0.1.0"
  },
  "observability": { "enabled": true }
}
